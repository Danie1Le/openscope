# libFuzzer dictionary for the SCPI grammar (written out in src/openscope/scpi/parser.cpp):
# separators, the instrument's headers and parameter forms. Add new command mnemonics here.
sep_colon=":"
sep_semicolon=";"
sep_comma=","
sep_query="?"
sep_common="*"
sep_newline="\x0a"
sep_tab="\x09"
open_bracket="["
quote="\x22"
hash="#"
idn="*IDN?"
rst="*RST"
cls="*CLS"
syst="SYST"
system="SYSTEM"
err="ERR"
error="ERROR"
next="NEXT"
on="ON"
off="OFF"
exp_pos="E+"
exp_neg="E-"
num_big="1E999"
num_dot=".5"
khz="KHZ"
mhz="MHZ"
mv="MV"
exa="EX"
mega="MA"
